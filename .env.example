# Optional environment overrides. Copy to .env and adjust locally if needed.
# For local development these can usually be omitted; scripts resolve
# PROJECT_ROOT from the repository location.
#
# On a cluster, replace these neutral examples with account-specific paths.
# Do not commit .env.
PROJECT_ROOT=/srv/process-discovery-cash
DATA_ROOT=/srv/process-discovery-cash-data
RESULTS_ROOT=/srv/process-discovery-cash-results
LOG_ROOT=/srv/process-discovery-cash-logs/slurm
PYTHONPATH=/srv/process-discovery-cash/src

# Optional external Split Miner backend.
SPLIT_MINER_JAR=data/external/split-miner-1.7.1-all.jar
# If Slurm jobs cannot find "java", set this to the Java executable.
# Plain commands use PATH; paths with slashes are resolved relative to PROJECT_ROOT.
JAVA_BIN=data/external/jdk1.8.0_202/bin/java

# Optional Slurm defaults. Shell wrappers load this file automatically and real
# environment variables still take precedence.
DISCOVERY_PARTITION=CPU
DISCOVERY_QOS=minor_student
DISCOVERY_TIME=24:00:00
DISCOVERY_MEM=16G
# METRIC_PARTITION=CPU
# METRIC_QOS=minor_student
# METRIC_TIME=08:00:00
# METRIC_MEM=16G

# Optional GEDI feature-space synthesis defaults (see docs/feature_space_generation.md).
# GEDI_PYTHON=/srv/process-discovery-cash/.venv-gedi/bin/python
# GEDI_PARTITION=CPU
# GEDI_QOS=minor_student
# GEDI_TIME=03:00:00
# GEDI_MEM=8G
